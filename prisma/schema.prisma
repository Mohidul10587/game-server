generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  referralCode String   @unique
  referredBy   String?
  role         Role     @default(USER)
  isBanned     Boolean  @default(false)
  isSuspicious Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  miningPower        MiningPower?
  coinBalance        CoinBalance?
  cryptoBalances     CryptoBalance[]
  gameSessionss      GameSession[]
  userMiners         UserMiner[]
  rewardHistory      RewardHistory[]
  withdrawals        Withdrawal[]
  userQuests         UserQuest[]
  referralsSent      Referral[]           @relation("ReferrerRelation")
  poolAllocations    UserPoolAllocation[]
  miningRooms        MiningRoom[]
  depositAddresses   DepositAddress[]
  deposits           Deposit[]
  rackInventory      UserRackInventory[]
  rackPlacements     UserRackPlacement[]
  minerPlacements    UserMinerPlacement[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

// ─────────────────────────────────────────
// MINING POWER
// ─────────────────────────────────────────
model MiningPower {
  id             String    @id @default(cuid())
  userId         String    @unique
  temporaryPower Int       @default(0)
  permanentPower Int       @default(0)
  tempExpiresAt  DateTime?
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mining_power")
}

// ─────────────────────────────────────────
// GAME SESSIONS
// ─────────────────────────────────────────
model GameSession {
  id          String            @id @default(cuid())
  userId      String
  gameType    String
  token       String            @unique
  status      GameSessionStatus @default(ACTIVE)
  score       Int?
  powerEarned Int?
  playedAt    DateTime?
  createdAt   DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("game_sessions")
}

enum GameSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

// ─────────────────────────────────────────
// MINERS (shop items — admin managed)
// ─────────────────────────────────────────
model Miner {
  id           String  @id @default(cuid())
  name         String
  description  String?
  rarity       Rarity
  basePower    Int     // Gh/s mining power
  miningPower  Int     @default(0) // alias kept for frontend compat
  price        Int     // in-game coins
  imageUrl     String
  minerType    String  @default("standard")
  isActive     Boolean @default(true)

  userMiners UserMiner[]

  @@map("miners")
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

// ─────────────────────────────────────────
// USER MINERS (owned miners — inventory)
// ─────────────────────────────────────────
model UserMiner {
  id         String   @id @default(cuid())
  userId     String
  minerId    String
  isActive   Boolean  @default(true)
  acquiredAt DateTime @default(now())

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  miner           Miner              @relation(fields: [minerId], references: [id])
  listings        MarketplaceListing[]
  slot            MinerSlot?         // legacy — kept for backward compat
  minerPlacement  UserMinerPlacement?

  @@map("user_miners")
}

// ─────────────────────────────────────────
// MARKETPLACE LISTINGS
// ─────────────────────────────────────────
model MarketplaceListing {
  id          String        @id @default(cuid())
  userMinerId String
  sellerId    String
  price       Int
  status      ListingStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  soldAt      DateTime?

  userMiner UserMiner @relation(fields: [userMinerId], references: [id])

  @@map("marketplace_listings")
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
}

// ─────────────────────────────────────────
// COIN BALANCE
// ─────────────────────────────────────────
model CoinBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  amount    Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coin_balances")
}

// ─────────────────────────────────────────
// CRYPTO BALANCE
// ─────────────────────────────────────────
model CryptoBalance {
  id        String   @id @default(cuid())
  userId    String
  currency  String
  amount    Decimal  @default(0) @db.Decimal(20, 8)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
  @@map("crypto_balances")
}

// ─────────────────────────────────────────
// REWARD HISTORY
// ─────────────────────────────────────────
model RewardHistory {
  id               String   @id @default(cuid())
  userId           String
  cycleId          String
  currency         String
  amount           Decimal  @db.Decimal(20, 8)
  poolSharePercent Decimal  @db.Decimal(10, 6)
  distributedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cycleId, currency])
  @@map("reward_history")
}

// ─────────────────────────────────────────
// WITHDRAWALS
// ─────────────────────────────────────────
model Withdrawal {
  id            String           @id @default(cuid())
  userId        String
  currency      String
  amount        Decimal          @db.Decimal(20, 8)
  walletAddress String
  status        WithdrawalStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  processedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
}

// ─────────────────────────────────────────
// QUESTS
// ─────────────────────────────────────────
model Quest {
  id             String     @id @default(cuid())
  title          String
  description    String
  type           QuestType
  requiredAction String
  targetValue    Int
  rewardType     RewardType
  rewardAmount   Int
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean    @default(true)

  userQuests UserQuest[]

  @@map("quests")
}

enum QuestType {
  DAILY
  WEEKLY
}

enum RewardType {
  COIN
  CRYPTO
  MINER
}

// ─────────────────────────────────────────
// USER QUEST PROGRESS
// ─────────────────────────────────────────
model UserQuest {
  id          String    @id @default(cuid())
  userId      String
  questId     String
  progress    Int       @default(0)
  isCompleted Boolean   @default(false)
  isClaimed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id])

  @@unique([userId, questId])
  @@map("user_quests")
}

// ─────────────────────────────────────────
// REFERRAL
// ─────────────────────────────────────────
model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  referredId    String   @unique
  bonusPaidDays Int      @default(0)
  createdAt     DateTime @default(now())

  referrer User @relation("ReferrerRelation", fields: [referrerId], references: [id])

  @@map("referrals")
}

// ─────────────────────────────────────────
// REWARD CONFIG
// ─────────────────────────────────────────
model RewardConfig {
  id                  String   @id @default(cuid())
  poolAmountPerCycle  Int      @default(50000)
  cycleMinutes        Int      @default(10)
  updatedAt           DateTime @updatedAt

  @@map("reward_config")
}

// ─────────────────────────────────────────
// MINING POOLS
// ─────────────────────────────────────────
model Pool {
  id                 String   @id @default(cuid())
  name               String   @unique
  currency           String   @unique
  poolAmountPerCycle Decimal  @default(0) @db.Decimal(20, 8)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  allocations UserPoolAllocation[]

  @@map("pools")
}

// ─────────────────────────────────────────
// USER POOL ALLOCATION
// ─────────────────────────────────────────
model UserPoolAllocation {
  id           String   @id @default(cuid())
  userId       String
  poolId       String
  powerPercent Decimal  @default(0) @db.Decimal(5, 2)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([userId, poolId])
  @@map("user_pool_allocations")
}

// ─────────────────────────────────────────
// MINING ROOM (multi-room system)
// 4 rooms per user. Room 01 = default unlocked.
// ─────────────────────────────────────────
model MiningRoom {
  id           String   @id @default(cuid())
  userId       String
  roomNumber   Int      @default(1) // 1-4
  isUnlocked   Boolean  @default(false)
  unlockCost   Int      @default(0)
  gridCols     Int      @default(4)  // rack grid columns
  gridRows     Int      @default(3)  // rack grid rows (max 12 racks)
  totalSlots   Int      @default(9)  // legacy — kept for backward compat
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots         MinerSlot[]         // legacy
  rackPlacements UserRackPlacement[]

  @@unique([userId, roomNumber])
  @@map("mining_rooms")
}

// ─────────────────────────────────────────
// MINER SLOT (legacy — kept for backward compat)
// ─────────────────────────────────────────
model MinerSlot {
  id          String    @id @default(cuid())
  roomId      String
  slotIndex   Int
  userMinerId String?   @unique
  placedAt    DateTime?

  room      MiningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userMiner UserMiner? @relation(fields: [userMinerId], references: [id], onDelete: SetNull)

  @@unique([roomId, slotIndex])
  @@map("miner_slots")
}

// ─────────────────────────────────────────
// RACK PRODUCT (admin-managed shop items)
// ─────────────────────────────────────────
model RackProduct {
  id            String   @id @default(cuid())
  name          String
  description   String?
  imageUrl      String   @default("/assets/racks/rack-basic.svg")
  price         Int      // in-game coins
  minerCapacity Int      @default(4)  // how many miners can be placed
  rackType      String   @default("basic")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rackInventory  UserRackInventory[]
  rackPlacements UserRackPlacement[]

  @@map("rack_products")
}

// ─────────────────────────────────────────
// USER RACK INVENTORY (owned racks in storage)
// ─────────────────────────────────────────
model UserRackInventory {
  id            String   @id @default(cuid())
  userId        String
  rackProductId String
  acquiredAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rackProduct RackProduct @relation(fields: [rackProductId], references: [id])
  placement   UserRackPlacement? // null = in storage, set = placed in room

  @@map("user_rack_inventory")
}

// ─────────────────────────────────────────
// USER RACK PLACEMENT (rack placed in a room)
// ─────────────────────────────────────────
model UserRackPlacement {
  id              String    @id @default(cuid())
  userId          String
  roomId          String
  rackInventoryId String    @unique  // one rack can only be in one place
  rackProductId   String
  slotIndex       Int       // grid position in room (0-based)
  placedAt        DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  room           MiningRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  rackInventory  UserRackInventory @relation(fields: [rackInventoryId], references: [id], onDelete: Cascade)
  rackProduct    RackProduct       @relation(fields: [rackProductId], references: [id])
  minerPlacements UserMinerPlacement[]

  @@unique([roomId, slotIndex])  // one rack per slot
  @@map("user_rack_placements")
}

// ─────────────────────────────────────────
// USER MINER PLACEMENT (miner inside a rack)
// ─────────────────────────────────────────
model UserMinerPlacement {
  id               String    @id @default(cuid())
  userId           String
  rackPlacementId  String
  userMinerId      String    @unique  // one miner can only be in one place
  slotIndex        Int       // position inside rack (0-based)
  placedAt         DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rackPlacement  UserRackPlacement @relation(fields: [rackPlacementId], references: [id], onDelete: Cascade)
  userMiner      UserMiner         @relation(fields: [userMinerId], references: [id], onDelete: Cascade)

  @@unique([rackPlacementId, slotIndex])  // one miner per rack slot
  @@map("user_miner_placements")
}

// ─────────────────────────────────────────
// ROOM CONFIG (admin-controlled unlock costs)
// ─────────────────────────────────────────
model RoomConfig {
  id         String   @id @default(cuid())
  roomNumber Int      @unique // 1-4
  unlockCost Int      @default(0)
  name       String   @default("")
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@map("room_config")
}

// ─────────────────────────────────────────
// DEPOSIT ADDRESSES
// ─────────────────────────────────────────
model DepositAddress {
  id        String   @id @default(cuid())
  userId    String
  currency  String
  address   String   @unique
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deposits Deposit[]

  @@unique([userId, currency])
  @@map("deposit_addresses")
}

model Deposit {
  id               String        @id @default(cuid())
  depositAddressId String
  userId           String
  currency         String
  amount           Decimal       @db.Decimal(20, 8)
  txHash           String?       @unique
  status           DepositStatus @default(PENDING)
  confirmedAt      DateTime?
  createdAt        DateTime      @default(now())

  depositAddress DepositAddress @relation(fields: [depositAddressId], references: [id])
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("deposits")
}

enum DepositStatus {
  PENDING
  CONFIRMED
  FAILED
}
